{
    "$schema": "vscode://schemas/color-theme",
    "name": "Plain Light Theme",
    "colors": {
        "editor.background": "#fbf8f1",
        "editor.foreground": "#65635d"
    },
    "tokenColors": [
        {
            "scope": "comment",
            "settings": { "foreground": "#bc7533" }
        },
        {
            "scope": "string",
            "settings": { "foreground": "#2c9768" }
        },
        {
            "scope": "constant",
            "settings": { "foreground": "#9577c7" }
        },
        {
            "scope": "keyword",
            "settings": { "foreground": "#308dc5" }
        },
        {
            "scope": "storage",
            "settings": { "foreground": "#308dc5" }
        },
        {
            "scope": "support.type",
            "settings": { "foreground": "#00969d" }
        }
    ]
}
